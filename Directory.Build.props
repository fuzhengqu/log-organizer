<Project>

  <!-- Single source of truth for the shipped version. Bump by 0.01 per change: 0.03 -> 0.04 -> 0.05. -->
  <PropertyGroup>
    <Version>0.03</Version>
    <InformationalVersion>0.03</InformationalVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.03.0.0</FileVersion>
    <Product>日志归档助手</Product>
    <AssemblyTitle>日志归档助手</AssemblyTitle>
    <Company>fuzhengqu</Company>
    <Authors>fuzhengqu</Authors>
    <Copyright>Copyright (C) 2026 fuzhengqu</Copyright>
    <RepositoryUrl>https://github.com/fuzhengqu/log-organizer</RepositoryUrl>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>