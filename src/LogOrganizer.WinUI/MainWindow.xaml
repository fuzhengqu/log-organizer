<Window
    x:Class="LogOrganizer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    Title="日志归档助手">
    <Grid x:Name="RootSurface" Background="{ThemeResource AppSolidSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent"
                BorderBrush="{ThemeResource AppLineBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBar">
                <!-- Header content. Right padding is computed so text never runs under the pin button. -->
                <Grid x:Name="TitleBarHeader" Padding="20,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="38" Height="38" Stretch="Uniform"
                           Source="ms-appx:///Assets/LogOrganizer-256.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="日志归档助手" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource AppTextBrush}" />
                        <TextBlock x:Name="InboxSubtitle" FontSize="11" Foreground="{ThemeResource AppMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
                <!-- Fourth title-bar button: same size, position and states as minimise/maximise/close. -->
                <ToggleButton x:Name="AlwaysOnTopButton"
                              Style="{StaticResource CaptionToggleButtonStyle}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,138,0"
                              ToolTipService.ToolTip="取消置顶，恢复静默期归档提示"
                              AutomationProperties.Name="置顶归档窗口"
                              Checked="OnAlwaysOnTopChanged" Unchecked="OnAlwaysOnTopChanged" />
            </Grid>
        </Border>

        <!-- MaxWidth keeps the cards readable when the panel is maximised on a wide display. -->
        <Grid Grid.Row="1" Padding="18,14,18,10" RowSpacing="10" MaxWidth="860" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock x:Name="PendingTitle" Text="待归档项目" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                    <TextBlock x:Name="PendingSubtitle" Text="文件只会在点击归档后移动" FontSize="11" Foreground="{ThemeResource AppMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="添加文件" Click="OnAddFiles" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1">
                <ListView x:Name="ItemsList" SelectionMode="None" IsItemClickEnabled="False"
                          AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
                          Background="Transparent" BorderThickness="0" Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource AppCardBrush}"
                                    BorderBrush="{ThemeResource AppLineBrush}" BorderThickness="1"
                                    CornerRadius="9" Margin="0,0,0,6" Padding="12,9,8,9">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AppAccentBrush}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppTextBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SourcePath}" FontSize="10" Foreground="{ThemeResource AppMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Error}" FontSize="10" Foreground="{ThemeResource AppDangerBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Tag="{Binding SourcePath}" Click="OnRemoveItem"
                                            Width="30" Height="30" Padding="0" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="从列表移除；不会删除源文件">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource AppMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="拖入文件，或点击「添加文件」" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="中转目录里的文件也会自动出现在这里" FontSize="11" Foreground="{ThemeResource AppMutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="6">
                <TextBlock Text="问题单号" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AppTextBrush}" />
                <TextBox x:Name="TicketBox" PlaceholderText="输入纯数字单号" MaxLength="24"
                         BeforeTextChanging="OnTicketBeforeTextChanging" TextChanged="OnTicketTextChanged" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Grid.Row="3" FontSize="11" Foreground="{ThemeResource AppMutedBrush}"
                       TextTrimming="CharacterEllipsis" MinHeight="16" />
        </Grid>

        <Border Grid.Row="2" Padding="18,11" Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource AppLineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8" MaxWidth="860" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsButton" Content="设置" Click="OnOpenSettings" HorizontalAlignment="Left" />
                <Button x:Name="ArchiveButton" Grid.Column="1" Content="归档" Click="OnArchive" IsEnabled="False"
                        MinWidth="112" Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>

        <!-- Icon and right-click menu are assigned in code-behind: the menu is a Win32 popup so it
             can open at the cursor, next to the tray icon. -->
        <tb:TaskbarIcon x:Name="Tray" ToolTipText="日志归档助手"
                        DoubleClickCommand="{x:Bind TrayDoubleClickCommand}" Width="1" Height="1"
                        Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>