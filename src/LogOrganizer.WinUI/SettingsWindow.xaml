<Window
    x:Class="LogOrganizer.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="设置">
    <Grid x:Name="RootSurface" Background="{ThemeResource AppSolidSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Same title bar as the archive window so the two surfaces read as one app. -->
        <Border Grid.Row="0" Background="Transparent"
                BorderBrush="{ThemeResource AppLineBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="TitleBar">
                <Grid x:Name="TitleBarHeader" Padding="20,14" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Width="38" Height="38" Stretch="Uniform"
                           Source="ms-appx:///Assets/LogOrganizer-256.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="设置" FontSize="18" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource AppTextBrush}" />
                        <TextBlock Text="配置中转目录、归档位置与外观" FontSize="11"
                                   Foreground="{ThemeResource AppMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Cards stretch to the same 860 measure as the archive window; MaxWidth centres them when maximised. -->
        <ScrollViewer Grid.Row="1" Padding="20,14" HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="12" MaxWidth="860" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="路径" Style="{StaticResource AppSectionTitleStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="中转目录根路径" Style="{StaticResource AppFieldLabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InboxRootBox" />
                                <Button Grid.Column="1" Content="浏览…" Click="OnBrowseInbox" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="中转文件夹名称（工具会自动创建）" Style="{StaticResource AppFieldLabelStyle}" />
                            <TextBox x:Name="InboxNameBox" TextChanged="OnInboxChanged" />
                            <TextBlock x:Name="InboxPreview" FontSize="10" Foreground="{ThemeResource AppMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="目标目录（单号文件夹会创建在这里，必须已存在）" Style="{StaticResource AppFieldLabelStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TargetBox" />
                                <Button Grid.Column="1" Content="浏览…" Click="OnBrowseTarget" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="行为" Style="{StaticResource AppSectionTitleStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="静默等待秒数（文件停止变化后等待多久再提示）" Style="{StaticResource AppFieldLabelStyle}" />
                            <NumberBox x:Name="QuietSecondsBox" Minimum="1" Maximum="600"
                                       SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <CheckBox x:Name="StartupBox" Content="开机自动启动（默认关闭）" />
                        <StackPanel Spacing="4">
                            <CheckBox x:Name="HotkeyBox" Content="启用全局快捷键唤醒（默认关闭）"
                                      Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="HotkeyButton" HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Click="OnHotkeyButtonClick" PreviewKeyDown="OnHotkeyCaptureKeyDown"
                                        AutomationProperties.Name="唤醒快捷键" />
                                <Button Grid.Column="1" Content="恢复默认" Click="OnHotkeyReset" />
                            </Grid>
                            <TextBlock x:Name="HotkeyHint" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{ThemeResource AppMutedBrush}" />
                        </StackPanel>
                        <CheckBox x:Name="PinnedBox" Content="启动时置顶显示；取消置顶后恢复静默期提示" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource AppCardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="外观" Style="{StaticResource AppSectionTitleStyle}" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="窗口背景" Style="{StaticResource AppFieldLabelStyle}" />
                            <ComboBox x:Name="BackdropBox" HorizontalAlignment="Stretch" SelectionChanged="OnBackdropChanged">
                                <ComboBoxItem Content="Mica（Windows 11 桌面材质）" Tag="Mica" />
                                <ComboBoxItem Content="亚克力（更强模糊）" Tag="Acrylic" />
                                <ComboBoxItem Content="纯色（兼容模式）" Tag="Solid" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="置顶模式下窗口透明度" Style="{StaticResource AppFieldLabelStyle}" />
                            <Slider x:Name="OpacitySlider" Minimum="40" Maximum="100" StepFrequency="5"
                                    ValueChanged="OnOpacityChanged" />
                            <TextBlock x:Name="OpacityValue" Text="92%" FontSize="11"
                                       Foreground="{ThemeResource AppMutedBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="18,11" Background="{ThemeResource AppCardBrush}"
                BorderBrush="{ThemeResource AppLineBrush}" BorderThickness="0,1,0,0">
            <Grid MaxWidth="860" HorizontalAlignment="Stretch" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Kept outside the scroll area so a save error can never hide below the fold. -->
                <TextBlock x:Name="ValidationText" Grid.Row="0" FontSize="11"
                           Foreground="{ThemeResource AppDangerBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" Grid.Row="1" VerticalAlignment="Center" FontSize="11"
                           HorizontalAlignment="Left"
                           Foreground="{ThemeResource AppMutedBrush}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="取消" Click="OnCancel" />
                    <Button Content="保存设置" Click="OnSave" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>